{
  "name": "@bugbubug/llm-kit",
  "version": "0.2.4",
  "description": "Pure, framework/runtime-agnostic LLM gateway SDK — contracts + egress adapters only (Cloudflare Workers AI, Gemini dual-channel [Vertex/Developer], OpenRouter + deterministic configurable mock). Streaming AND native non-streaming chat (streamChat/generate) + vision + image-gen + embed + thinking. NO routing, NO product policy.",
  "license": "MIT",
  "author": "bugbubug",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/cloudflare": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./adapters/gemini": {
      "types": "./dist/adapters/gemini.d.ts",
      "default": "./dist/adapters/gemini.js"
    },
    "./adapters/openrouter": {
      "types": "./dist/adapters/openrouter.d.ts",
      "default": "./dist/adapters/openrouter.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "default": "./dist/mock.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "api:check": "api-extractor run --verbose",
    "api:update": "api-extractor run --local --verbose"
  },
  "peerDependencies": {
    "zod": "^3.24.1"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@eslint/js": "^9.0.0",
    "@microsoft/api-extractor": "^7.47.0",
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.60.1",
    "ajv": "^8",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "zod": "^3.24.1"
  }
}
