{
  "name": "@bugbubug/llm-kit",
  "version": "0.1.0",
  "description": "Pure, framework/runtime-agnostic LLM gateway SDK — contracts + egress adapters only (Cloudflare Workers AI via AI Gateway + deterministic mock). Streaming-first chat (streamChat/generate) + embed. NO routing, NO product policy.",
  "license": "MIT",
  "author": "bugbubug",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/cloudflare": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "default": "./dist/mock.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^3.24.1"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^3.24.1",
    "@types/node": "^22.0.0",
    "@cloudflare/workers-types": "^4.0.0"
  }
}
